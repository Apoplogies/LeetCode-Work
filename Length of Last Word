class Solution {
    public int lengthOfLastWord(String s) {

        //Find last word
        int last_word_ptr = 0;
        int last_char_ptr = s.length() - 1;

        for (int i = 0; i < s.length() - 1; i++) {

            if (s.charAt(i) == ' ' && s.charAt(i + 1) != ' ') {
                last_word_ptr = i + 1;
            }


        }

        while (s.charAt(last_char_ptr) == ' ') {
            last_char_ptr--;
        }

        //Count last word
        return (last_char_ptr - last_word_ptr + 1);




    }
}
