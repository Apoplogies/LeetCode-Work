/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int maxDepth(TreeNode root) {
        return DFSEverything(root);
    }

    int DFSEverything(TreeNode root) {
        if (root == null) {
            return 0;
        }

        else {
            int left = 1 + DFSEverything(root.left);
            int right = 1 + DFSEverything(root.right);
            if (left > right) {return left;}
            return right;
        }
    }
}
