class Solution {
    public void solve(char[][] board) {
        
        for (int i = 0; i < board[0].length; i++) {
            if (board[0][i] == 'O') {
                recurse(board, 0, i, board.length - 1, board[0].length- 1);
            }
            if (board[board.length - 1][i] == 'O') {
                recurse(board, board.length - 1, i, board.length - 1, board[0].length - 1);
            }
        }

        for (int i = 0; i < board.length; i++) {
            if (board[i][0] == 'O') {
                recurse(board, i, 0, board.length-1, board[i].length-1);
            }

            if (board[i][board[i].length - 1] == 'O') {
                recurse(board, i, board[i].length - 1, board.length - 1, board[i].length - 1);
            }
        }




        for (int i = 0; i < board.length; i++) {
            for (int j = 0; j < board[i].length; j++) {
                if (board[i][j] == 'O') {
                    board[i][j] = 'X';
                }
                else if (board[i][j] == 'M') {
                    board[i][j] = 'O';
                }
            }
        }


    }

    void recurse(char[][] board, int x, int y, int xmax, int ymax) {
        if (x < 0 || x > xmax || y < 0 || y > ymax) {
            ;
        }
       else  if (board[x][y] == 'O') {
            board[x][y] = 'M';
            recurse(board, x + 1, y, xmax, ymax);
            recurse(board, x - 1, y, xmax, ymax);
            recurse(board, x, y + 1, xmax, ymax);
            recurse(board, x, y - 1, xmax, ymax);
        }

        
    }

}
